{
  "name": "Jury FRAND Experiment",
  "description": "oTree experiment for jury decision-making on FRAND patent licensing rates",
  "repository": "https://github.com/yourusername/jury-frand-experiment",
  "keywords": ["otree", "experiment", "behavioral-economics", "patent-law", "frand"],
  "stack": "heroku-22",
  "buildpacks": [
    {
      "url": "heroku/python"
    }
  ],
  "env": {
    "OTREE_ADMIN_PASSWORD": {
      "description": "Password for the oTree admin interface",
      "required": true
    },
    "OTREE_PRODUCTION": {
      "description": "Set to 1 for production mode",
      "value": "1",
      "required": true
    },
    "RECAPTCHA_SECRET_KEY": {
      "description": "Google reCAPTCHA secret key for Study 2",
      "required": false
    }
  },
  "formation": {
    "web": {
      "quantity": 1,
      "size": "basic"
    },
    "worker": {
      "quantity": 1,
      "size": "basic"
    }
  }
}
